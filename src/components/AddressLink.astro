---
import type { Address } from '@/content/config'

const addressToString = (address: Address) =>
  `${address.streetAddress}, ${address.postalCode} ${address.addressLocality}`

interface Props {
  address?: Address
  className?: string
  name?: string
  url?: string
}

const { address, className, name, url } = Astro.props

const href = url
  ? url
  : address
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressToString(address))}`
    : undefined

const label = address
  ? `${name ? `${name}, ` : ''}${addressToString(address)}`
  : (name ?? '')
---

{
  href ? (
    <a href={href} target="_blank" rel="noopener noreferrer" class={className}>
      {label}
    </a>
  ) : (
    <span class={className}>{label}</span>
  )
}

