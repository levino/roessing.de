---
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import type { FullJob } from '@/types'
import AddressLink from './AddressLink.astro'

interface Props {
  job: FullJob
}

const EMPLOYMENT_TYPE_LABELS: Record<string, string> = {
  FULL_TIME: 'Vollzeit',
  PART_TIME: 'Teilzeit',
  CONTRACTOR: 'Auftrag',
  TEMPORARY: 'Befristet',
  INTERN: 'Praktikum',
  VOLUNTEER: 'Ehrenamt',
  PER_DIEM: 'Tageweise',
  OTHER: 'Sonstige',
}

const SALARY_UNIT_LABELS: Record<string, string> = {
  HOUR: 'Stunde',
  DAY: 'Tag',
  WEEK: 'Woche',
  MONTH: 'Monat',
  YEAR: 'Jahr',
}

const {
  job,
  job: {
    data: {
      title,
      image,
      employmentType,
      hoursPerWeek,
      baseSalary,
      location,
      hiringOrganization,
    },
  },
} = Astro.props

const { Content } = await render(job)

const formatSalary = (value: number, currency: string) =>
  new Intl.NumberFormat('de-DE', {
    style: 'currency',
    currency,
    minimumFractionDigits: 2,
  }).format(value)
---

<div class="container mx-auto px-4 py-8 max-w-4xl">
  {
    image && (
      <figure class="mb-6">
        <div class="aspect-[16/9] w-full overflow-hidden rounded-lg">
          <Image
            class="object-cover w-full h-full"
            src={image.src}
            alt={image.alt}
          />
        </div>
      </figure>
    )
  }

  <h1 class="text-3xl md:text-4xl font-bold break-words min-w-0 mb-4">
    {title}
  </h1>

  <div class="flex flex-wrap gap-2 mb-6">
    {
      employmentType.map((type) => (
        <span class="badge badge-primary badge-lg">
          {EMPLOYMENT_TYPE_LABELS[type] ?? type}
        </span>
      ))
    }
  </div>

  <div class="flex flex-col gap-3 mb-6">
    {
      hoursPerWeek && (
        <div class="flex items-center gap-3 text-base-content/70">
          <svg
            class="w-5 h-5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <div>
            <span class="font-medium">Arbeitszeit:</span> {hoursPerWeek} Stunden pro Woche
          </div>
        </div>
      )
    }

    {
      baseSalary && (
        <div class="flex items-center gap-3 text-base-content/70">
          <svg
            class="w-5 h-5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V6m0 12v-2m0-8a3 3 0 013 3"
            />
          </svg>
          <div>
            <span class="font-medium">Vergütung:</span>{' '}
            {formatSalary(baseSalary.value, baseSalary.currency)} pro {SALARY_UNIT_LABELS[baseSalary.unitText] ?? baseSalary.unitText}
          </div>
        </div>
      )
    }

    {
      location && (location.data.address || location.data.url) && (
        <div class="flex items-center gap-3 text-base-content/70">
          <svg
            class="w-5 h-5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
            />
          </svg>
          <AddressLink
            name={location.data.name}
            address={location.data.address}
            url={location.data.url}
            className="link link-primary"
          />
        </div>
      )
    }
  </div>

  <div class="prose prose-lg max-w-none">
    <Content />
  </div>

  {
    hiringOrganization && (
      <>
        <div class="divider" />
        <div class="mt-2">
          <div class="flex items-center gap-3 mb-3">
            <svg
              class="w-5 h-5 flex-shrink-0 text-base-content/60"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            <span class="text-base-content/60 font-semibold">Anbieter:in</span>
          </div>
          <h2 class="font-bold text-xl text-base-content mb-2">{hiringOrganization.data.name}</h2>
          {hiringOrganization.data.email && (
            <div class="flex items-center gap-3 text-base-content/70 mb-1">
              <svg
                class="w-4 h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
              <a href={`mailto:${hiringOrganization.data.email}`} class="link link-primary">
                {hiringOrganization.data.email}
              </a>
            </div>
          )}
          {hiringOrganization.data.telephone && (
            <div class="flex items-center gap-3 text-base-content/70">
              <svg
                class="w-4 h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
              <a href={`tel:${hiringOrganization.data.telephone}`} class="link link-primary">
                {hiringOrganization.data.telephone}
              </a>
            </div>
          )}
        </div>
      </>
    )
  }
</div>
