---
import { Image } from 'astro:assets'
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import { kontaktMail, kontaktTelefon, mailtoMitBetreff } from '@/data/kontakt'
import { aushangFormate } from '@/tools/print/aushang'
import appDetail from '../assets/app/app-detail.png'
import appKarte from '../assets/app/app-karte.png'
import appListe from '../assets/app/app-liste.png'
import appProfil from '../assets/app/app-profil.png'
import appRangliste from '../assets/app/app-rangliste.png'
import appStartseite from '../assets/app/app-startseite.png'
import AppDownload from '../components/AppDownload.astro'
import IdeenFormular from '../components/IdeenFormular.astro'
import Jumbotron from '../components/Jumbotron.astro'

const metadata = {
  title: 'Die Rössing-App',
  description:
    'Was soll die Dorf-App für Rössing können? Wir sammeln Ideen aus dem Dorf – ein Satz reicht. Die App gibt es schon: Den Anfang macht „Mithelfen“ als erste Funktion – auf der Dorfkarte sehen, was gerade im Dorf ansteht, etwa welche Blumenkästen und Beete Wasser brauchen. Wer mag, trägt sich an einem Ort als Helfer:in ein und wird gefragt, sobald dort etwas fällig wird. Wer beim Test mitmachen möchte, meldet sich ebenfalls.',
}

// Anregungen, was eine Dorf-App leisten könnte. Ausdrücklich Beispiele –
// weder Versprechen noch Roadmap. Sie sollen zeigen, wie weit der Rahmen ist.
const ideenBeispiele = [
  {
    titel: 'Termine aus dem Dorf',
    text: 'Alle Veranstaltungen auf dem Telefon – mit einer Erinnerung am Tag davor, damit das Feuerwehrfest nicht wieder verpasst wird.',
  },
  {
    titel: 'Mitfahrgelegenheiten',
    text: 'Wer fährt morgen früh nach Hildesheim oder Nordstemmen und hat einen Platz frei? Wer braucht eine Mitfahrt?',
  },
  {
    titel: 'Werkzeug und Geräte verleihen',
    text: 'Anhänger, Vertikutierer, Bohrhammer, Bierzeltgarnitur: Wer hat was und gibt es gern weiter?',
  },
  {
    titel: 'Schwarzes Brett',
    text: 'Suche und Biete für Rössing – vom Kinderfahrrad über Brennholz bis zur freien Wohnung.',
  },
  {
    titel: 'Nachbarschaftshilfe',
    text: 'Einkauf mitbringen, Kinder von der Schule abholen, im Garten helfen: fragen, wenn man Hilfe braucht, und sehen, wo man helfen kann.',
  },
  {
    titel: 'Nachrichten der Vereine',
    text: 'Kurze Mitteilungen an die, die es angeht – Trainingsausfall, Probentermin, Absage wegen Regen. Ohne dass alle in jeder WhatsApp-Gruppe sein müssen.',
  },
  {
    titel: 'Kaputtes melden',
    text: 'Straßenlaterne aus, Bank wackelt, Spielgerät defekt: einmal fotografieren, melden, und alle sehen, dass es bekannt ist.',
  },
  {
    titel: 'Dorfchronik und Bilder',
    text: 'Alte Fotos und Geschichten aus Rössing zum Stöbern – und alle können ergänzen, was sie im Schrank haben.',
  },
]

// Was eine gute Idee ausmacht – bewusst als Anhaltspunkt, nicht als Formular.
const ideenHinweise = [
  {
    titel: 'Was soll die App tun?',
    text: 'Ein Satz genügt: „Ich möchte sehen, wann der nächste Bus fährt.“',
  },
  {
    titel: 'Für wen ist das?',
    text: 'Für alle im Dorf, für einen Verein, für Familien mit kleinen Kindern, für dich selbst?',
  },
  {
    titel: 'Was ist heute umständlich?',
    text: 'Woran es gerade hakt, ist oft der beste Hinweis darauf, was die App besser machen könnte.',
  },
]

// Die Haltung hinter dem Projekt – bewusst gut sichtbar auf der Seite.
const haltung = [
  {
    titel: 'Aus dem Dorf, ehrenamtlich',
    text: 'Die App entsteht in der Freizeit, als Teil des digitalen Dorfs. Kein Unternehmen dahinter, keine Agentur, kein Auftrag.',
  },
  {
    titel: 'Kostenlos',
    text: 'Die App kostet nichts – kein Kaufpreis, kein Abo, keine Zusatzkäufe. Auch später nicht.',
  },
  {
    titel: 'Keine Werbung',
    text: 'In der App läuft keine Werbung und kein Werbe-Tracking. Deine Daten werden nicht verkauft. Weitergegeben wird nur das, was für Benachrichtigungen aufs Handy nötig ist.',
  },
  {
    titel: 'Keine Gewinnabsicht',
    text: 'Niemand verdient daran – weder an der App noch an den Daten. Es geht darum, dass die App dem Dorf nützt – angefangen damit, dass die Blumenkästen gegossen werden.',
  },
  {
    titel: 'Datenschutz wird eingehalten',
    text: 'Die Daten liegen auf einem selbst betriebenen Server, die Anmeldung läuft über die eigene Rössing-ID – das Konto legst du dir dort selbst an –, und der Standort bleibt auf dem Gerät. Über Google laufen nur die Benachrichtigungen aufs Handy (abschaltbar in den Android-Einstellungen) und, falls du diesen Weg wählst, die freiwillige Anmeldung mit dem Google-Konto.',
  },
  {
    titel: 'Der Quellcode soll offen werden',
    text: 'Der Quellcode liegt derzeit noch in einem privaten Repository. Die Absicht ist, ihn offenzulegen, sobald die App über den ersten Test hinaus ist.',
  },
]

// Ampel-Logik der App – dieselben drei Zustände wie in der App selbst.
const ampel = [
  {
    farbe: 'bg-success',
    badge: 'badge-success',
    label: 'Grün',
    titel: 'Alles gut',
    text: 'Hier ist alles erledigt. Du kannst beruhigt weitergehen.',
  },
  {
    farbe: 'bg-warning',
    badge: 'badge-warning',
    label: 'Gelb',
    titel: 'Bitte gießen',
    text: 'Der übliche Abstand ist überschritten – wer vorbeikommt, darf gern gießen oder jäten.',
  },
  {
    farbe: 'bg-error',
    badge: 'badge-error',
    label: 'Rot',
    titel: 'Dringend',
    text: 'Hier wartet die Pflanze schon länger. Jetzt wird es Zeit.',
  },
]

// Die Bereiche, die es in der App heute gibt. „Mithelfen“ steht bewusst
// zuerst – es ist die erste Funktion und der Grund, warum es die App gibt.
const bereiche = [
  {
    titel: 'Mithelfen',
    text: 'Was gerade im Dorf ansteht: Blumenkästen und Beete auf der Dorfkarte und als Liste, jeweils mit Ampel. Erledigt wird mit einem Tipp gemeldet.',
  },
  {
    titel: 'Als Helfer:in eintragen',
    text: 'Bei jedem Ort kannst du dich eintragen – für alles, was dort ansteht, oder nur fürs Gießen bzw. nur fürs Jäten. Dann fragt dich die App, wenn dort etwas fällig wird.',
  },
  {
    titel: 'Benachrichtigungen',
    text: 'Hier stehen die Anfragen: zusagen mit „Ich mache das“, zurückgeben mit „Zurückgeben“. Auf Wunsch kommen sie zusätzlich aufs Handy – nachts ist Ruhe.',
  },
  {
    titel: 'Rangliste',
    text: 'Wer wie oft gegossen oder gejätet hat – wahlweise für die Woche, den Monat, die Saison, das Jahr oder insgesamt. Dazu, was das ganze Dorf zusammen geschafft hat, und ein paar Abzeichen.',
  },
  {
    titel: 'Mein Profil',
    text: 'Anzeigename, Nickname für die Rangliste, Telefonnummer, E-Mail und eine kurze Notiz. Für jedes Feld stellst du selbst ein, ob die anderen es sehen dürfen. Telefon und E-Mail sind zunächst nicht sichtbar.',
  },
  {
    titel: 'Dorfbewohner',
    text: 'Wer in der App mitmacht – mit genau den Angaben, die derjenige freigegeben hat. So findet man jemanden, ohne erst herumzufragen.',
  },
  {
    titel: 'Idee vorschlagen',
    text: 'Eine Kachel auf der Startseite der App: Sag uns, was die App sonst noch können soll. Geht auch anonym und dauert einen Satz.',
  },
  {
    titel: 'Dein Standort, wenn du magst',
    text: 'Gibst du den Standort frei, startet die Karte bei dir und die Liste zeigt, wie weit jeder Ort entfernt ist. Der Standort bleibt dabei auf dem Gerät.',
  },
  {
    titel: 'Weitere Bereiche kommen',
    text: 'Auf der Startseite steht es so auch in der App: Was als Nächstes dazukommt, entscheiden die Ideen aus dem Dorf.',
  },
]

// Screenshots aus der App (Android, Testphase).
const screenshots = [
  {
    src: appStartseite,
    alt: 'Startseite der Rössing-App mit der Begrüßung „Moin, Erna!“, der großen Kachel „Mithelfen – Was gerade im Dorf ansteht“ mit dem Hinweis „2 Orte warten auf dich“ sowie den Kacheln „Mein Profil“ und „Dorfbewohner“.',
    caption: 'Die Startseite mit den Bereichen der App',
  },
  {
    src: appKarte,
    alt: 'Dorfkarte von Rössing in der App mit farbigen Punkten – grün, gelb und rot – rund um das Wasserschloss, dazu ein Knopf für den eigenen Standort.',
    caption: 'Die Dorfkarte mit Ampel-Markern',
  },
  {
    src: appListe,
    alt: 'Listenansicht in der App, sortierbar nach Dringlichkeit oder Entfernung: „Unter den Eichen — Kasten 1“ mit rotem „Dringend!“, darunter gelbe und grüne Einträge.',
    caption: 'Alle Orte als Liste – nach Dringlichkeit oder Entfernung',
  },
  {
    src: appDetail,
    alt: 'Detailansicht eines Blumenkastens in der App mit der Angabe „10 Liter, alle 7 Tage“, dem Vermerk „Zuletzt: 9.8.2026 17:20 von Karl“ und dem Knopf „Ich habe gegossen“.',
    caption: 'Melden, dass du gegossen hast',
  },
  {
    src: appRangliste,
    alt: 'Rangliste in der App mit den Zeiträumen Woche, Monat, Saison, Jahr und Gesamt, der Dorfsumme „31 Erledigungen · 310 Liter · 4 Beteiligte“ und den Plätzen eins bis vier.',
    caption: 'Die Rangliste – auch für das ganze Dorf',
  },
  {
    src: appProfil,
    alt: 'Profilseite in der App mit den Feldern Anzeigename und Nickname, jeweils mit einem Schalter „Für alle Dorfbewohner sichtbar“, darunter das freiwillige Feld für die Telefonnummer.',
    caption: 'Im Profil entscheidest du Feld für Feld, wer was sieht',
  },
]
---

<Layout {...metadata}>
  <Jumbotron>
    <div class="m-auto max-w-3xl text-center">
      <span class="badge badge-accent badge-lg mb-4">Ideen gesucht</span>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Was soll die Rössing-App können?
      </h1>
      <p class="mt-6 text-lg leading-8 text-white/90">
        Es gibt sie schon. Den Anfang macht <strong>„Mithelfen“</strong> – die
        <strong>erste Funktion</strong> zeigt, was gerade im Dorf ansteht:
        welche Blumenkästen und Beete Wasser brauchen. Das ist der Anfang,
        nicht der Zweck. Jetzt kommt die eigentliche Frage – <strong>wofür soll
        die Dorf-App gut sein?</strong>
      </p>
      <p class="mt-4 text-lg leading-8 text-white/90">
        Denk dabei ruhig groß: Technisch ist erstaunlich viel möglich, und
        Ideen, die dem Dorf wirklich helfen, werden auch gebaut. Ein Satz
        reicht uns.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="#ideen" class="btn btn-primary btn-lg">
          Idee vorschlagen
        </a>
        <a href="#mitmachen" class="btn btn-lg glass text-white">
          Beim Test mitmachen
        </a>
      </div>
    </div>
  </Jumbotron>

  {/* Die Hauptsache: Ideen aus dem Dorf sammeln */}
  <section
    id="ideen"
    class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]"
  >
    <div class="container max-w-7xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Deine Idee
        </p>
        <h2
          class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
        >
          Sag uns, was die App fürs Dorf können soll
        </h2>
        <p class="mt-3 text-base-content/70">
          Die Rössing-App ist als App für das ganze Dorf gedacht, nicht als
          reine Gieß-App. „Mithelfen“ ist <strong>nur die erste
          Funktion</strong> – sie steht, und alles Weitere entsteht aus euren
          Vorschlägen. Was als Nächstes hineinkommt, soll sich daran
          entscheiden, was hier tatsächlich gebraucht wird. Deshalb die Frage
          an alle im Dorf: <strong>Was würde dir den Alltag in Rössing
          leichter machen?</strong>
        </p>
        <p class="mt-3 text-base-content/70">
          Trau dich, groß zu denken. Vieles, was nach viel Aufwand klingt, ist
          technisch gut machbar – und Ideen, die wirklich weiterhelfen, werden
          auch umgesetzt. Was wir nicht bauen können, sagen wir ehrlich.
        </p>
      </div>

      <div class="mt-12">
        <h3 class="text-xl font-semibold text-base-content">
          Denkbar wäre zum Beispiel …
        </h3>
        <p class="mt-2 max-w-3xl text-base-content/70">
          Das hier sind Anregungen, damit klar wird, wie weit der Rahmen ist –
          <strong>kein Versprechen und kein fertiger Plan.</strong> Nichts davon
          ist beschlossen. Vor allem interessiert uns, was <em>euch</em>
          einfällt.
        </p>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            ideenBeispiele.map((idee) => (
              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <h4 class="card-title text-lg text-base-content">
                    {idee.titel}
                  </h4>
                  <p class="text-base-content/70">{idee.text}</p>
                </div>
              </div>
            ))
          }
        </div>

        <p class="mt-6 text-base-content/70">
          Und wenn deine Idee hier nicht dabei ist: umso besser. Genau die
          suchen wir.
        </p>
      </div>

      <IdeenFormular />

      <div
        class="mt-8 rounded-box border border-base-300 bg-base-100 p-8 sm:p-10 shadow-sm"
      >
        <h3 class="text-xl font-semibold text-base-content">
          Wenn du magst, hilft uns das beim Verstehen
        </h3>
        <p class="mt-2 max-w-3xl text-base-content/70">
          Niemand muss etwas davon beantworten – <strong>ein Satz reicht.</strong>
          Es sind nur Anhaltspunkte für den Fall, dass du mehr erzählen willst.
        </p>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {
            ideenHinweise.map((hinweis) => (
              <div class="rounded-box border border-base-300 bg-base-200 p-6">
                <h4 class="font-semibold text-base-content">{hinweis.titel}</h4>
                <p class="mt-2 text-base-content/70">{hinweis.text}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <p class="text-sm text-base-content/60">
            Lieber per E-Mail? Geht auch: <a
              class="link"
              href={mailtoMitBetreff('Rössing-App: Meine Idee')}
              >{kontaktMail}</a
            > – und wer lieber redet als schreibt, ruft unter <a
              class="link"
              href={`tel:${kontaktTelefon}`}>{kontaktTelefon}</a
            > an.
          </p>
        </div>
      </div>
    </div>
  </section>

  <AppDownload />

  {/* So funktioniert's */}
  <section
    id="so-gehts"
    class="container max-w-5xl mx-auto px-4 py-16 sm:py-20"
  >
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">
        Was die App heute kann – den Anfang macht „Mithelfen“
      </p>
      <h2
        class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
      >
        Mithelfen: Was gerade im Dorf ansteht
      </h2>
      <p class="mt-3 text-base-content/70">
        Du hast Zeit und willst etwas fürs Dorf tun – aber was steht gerade an?
        Genau dafür ist „Mithelfen“ da, die erste Funktion der App. Sie ist
        bewusst schlicht gehalten: aufmachen, schauen, gießen, melden. Mehr
        braucht es nicht. Was danach dazukommt, hängt an den <a
          class="link link-primary"
          href="#ideen">Ideen aus dem Dorf</a
        >.
      </p>
      <p class="mt-3 text-base-content/70">
        Beim Öffnen landest du inzwischen auf einer Startseite mit den
        Bereichen der App. „Mithelfen“ steht dort oben – daneben gibt es die
        Benachrichtigungen, das eigene Profil, die Liste der Dorfbewohner und
        die Kachel „Idee vorschlagen“.
      </p>
    </div>

    <ul class="steps steps-vertical lg:steps-horizontal w-full mt-10">
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Anmelden</p>
          <p class="text-sm text-base-content/70">
            Einmalig mit der <a
              class="link"
              href="https://id.xn--rssing-wxa.de">Rössing-ID</a
            > anmelden – dem Dorf-Login, den es auch für die anderen Dorf-Dienste
            gibt. <strong>Das Konto legst du dir selbst an</strong> – mit
            Vorname, Nachname, E-Mail und Passwort, niemand muss es vorher für
            dich einrichten. Wer mag, nutzt stattdessen den Knopf „Mit Google
            anmelden“; nötig ist das nicht.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Karte anschauen</p>
          <p class="text-sm text-base-content/70">
            Auf der Dorfkarte zeigt eine Ampel, wo etwas ansteht – oder du
            gehst die Liste durch, nach Dringlichkeit oder nach Entfernung
            sortiert.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Gießen oder jäten</p>
          <p class="text-sm text-base-content/70">
            Bei jedem Ort steht, was zu tun ist – zum Beispiel „10 Liter, alle
            7 Tage“.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Melden</p>
          <p class="text-sm text-base-content/70">
            Ein Tipp auf „Ich habe gegossen“ – die Ampel springt auf Grün und
            alle anderen sehen es sofort, samt Name und Uhrzeit.
          </p>
        </div>
      </li>
    </ul>

    <p class="mt-10 max-w-3xl text-base-content/70">
      Damit nichts doppelt gegossen wird, ist ein Ort nach einer Erledigung
      eine Weile gesperrt – ungefähr das halbe Gießintervall, bei Hitze
      entsprechend kürzer. Wer die Kästen betreut, kann Erledigungen trotzdem
      nachtragen, wenn jemand das Melden vergessen hat.
    </p>

    <div class="mt-14">
      <h3 class="text-xl font-semibold text-base-content">
        Neu: Du kannst dich eintragen – und wirst dann gefragt
      </h3>
      <div class="mt-3 max-w-3xl space-y-3 text-base-content/70">
        <p>
          Bisher musste man selbst nachschauen, ob etwas ansteht. Seit der
          neuesten Version geht es auch andersherum: Bei jedem Ort gibt es
          „Hier als Helfer:in eintragen“. Wer das tut, sagt damit: Um diesen
          Kasten kümmere ich mich mit. Dabei kannst du angeben, ob du nur
          gießen, nur jäten oder alles übernehmen möchtest. Danach steht dort
          „Du hilfst hier mit“ – und du kannst dich jederzeit wieder
          austragen.
        </p>
        <p>
          Wird an diesem Ort etwas fällig, fragt die App nicht alle auf
          einmal, sondern <strong>der Reihe nach</strong>: eine Person, eine
          Stunde später die nächste, und so weiter. Wer zuerst dran ist,
          richtet sich danach, wer am längsten nichts gemacht hat
          beziehungsweise am längsten nicht gefragt wurde. So kommt jeder mal
          an die Reihe und niemand ständig.
        </p>
        <p>
          Sagst du zu – „Ich mache das“ –, <strong>gehört die Aufgabe für 24
          Stunden dir</strong>. Die anderen sehen, dass sie vergeben ist, und
          niemand läuft umsonst los. Wenn du es doch nicht schaffst, gibst du
          sie mit „Zurückgeben“ wieder frei; passiert gar nichts, wird sie
          nach den 24 Stunden von selbst frei und der Nächste wird gefragt.
          Und sobald irgendjemand meldet, dass gegossen ist, ist die Sache für
          alle erledigt.
        </p>
        <p>
          Hat am Ende niemand zugesagt, geht eine letzte Frage an alle
          Eingetragenen gleichzeitig. Meldet sich auch dann niemand, bleibt
          der Ort einfach rot stehen – so wie vorher auch.
        </p>
        <p>
          Die Anfragen stehen in der App unter „Benachrichtigungen“. Wer
          möchte, bekommt sie zusätzlich <strong>aufs Handy</strong>; die App
          fragt dafür einmal um Erlaubnis. Wer sie nicht gibt, verpasst
          nichts – die Anfragen stehen dann beim nächsten Öffnen da. Zwischen
          21 und 7 Uhr wird ohnehin nichts zugestellt.
        </p>
      </div>
    </div>

    <div class="mt-14">
      <h3 class="text-xl font-semibold text-base-content">
        Die Bereiche der App
      </h3>
      <p class="mt-2 max-w-3xl text-base-content/70">
        Das ist alles, was heute in der App steckt. „Mithelfen“ ist der erste
        Bereich; drumherum ist nach und nach das dazugekommen, was gemeinsames
        Gießen im Dorf braucht.
      </p>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          bereiche.map((bereich) => (
            <div class="card bg-base-100 border border-base-300 shadow-sm">
              <div class="card-body">
                <h4 class="card-title text-lg text-base-content">
                  {bereich.titel}
                </h4>
                <p class="text-base-content/70">{bereich.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Die Ampel – Full-Bleed-Band */}
  <section class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]">
    <div class="container max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-2xl mb-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Auf einen Blick
        </p>
        <h2
          class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
        >
          Grün, gelb, rot
        </h2>
        <p class="mt-3 text-base-content/70">
          Jeder Blumenkasten und jedes Beet hat einen Zustand. Wie lange etwas
          ohne Wasser auskommt, ist hinterlegt – bei Hitze wird der Abstand
          automatisch kürzer.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {
          ampel.map((zustand) => (
            <div class="card bg-base-100 border border-base-300 shadow-sm">
              <div class="card-body">
                <div class="flex items-center gap-3">
                  <span class={`inline-block size-5 rounded-full ${zustand.farbe}`} />
                  <h3 class="card-title text-base-content">{zustand.titel}</h3>
                </div>
                <span class={`badge ${zustand.badge} badge-sm w-fit`}>
                  {zustand.label}
                </span>
                <p class="text-base-content/70">{zustand.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Screenshots */}
  <section class="container max-w-7xl mx-auto px-4 py-16 sm:py-20">
    <div class="max-w-2xl mb-10">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">
        Blick in die App
      </p>
      <h2
        class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
      >
        So sieht das aus
      </h2>
      <p class="mt-3 text-base-content/70">
        Aufnahmen aus der Testversion für Android. Die Orte, Namen und Zahlen
        auf den Bildern sind Beispiele aus der Testumgebung – nicht die echten
        Kästen im Dorf. Die Bilder sind ein paar Wochen alt: Der Eintrag als
        Helfer:in, die Benachrichtigungen und die Kachel „Idee vorschlagen“
        sind darauf noch nicht zu sehen.
      </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {
        screenshots.map((shot) => (
          <figure class="flex flex-col gap-3">
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 320px, (min-width: 640px) 40vw, 45vw"
              class="w-full rounded-box border border-base-300 shadow-sm"
              loading="lazy"
            />
            <figcaption class="text-sm text-base-content/70">
              {shot.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* Eine App fürs ganze Dorf + Status */}
  <section class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]">
    <div class="container max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <h2 class="card-title text-2xl text-base-content">
              Eine App fürs ganze Dorf
            </h2>
            <p class="text-base-content/80">
              Die Rössing-App ist nicht als reine „Gieß-App“ gedacht, sondern
              als <strong>Dorf-App für Rössing</strong>.
              <strong>„Mithelfen“</strong> – was gerade im Dorf ansteht, also
              Blumenkästen und Beete – ist die <strong>erste Funktion</strong>,
              die fertig geworden ist. Weitere sollen nach und nach dazukommen.
            </p>
            <p class="text-base-content/80">
              Was genau als Nächstes kommt, versprechen wir bewusst noch nicht:
              Erst soll die erste Funktion im Alltag funktionieren. Womit es
              weitergeht, entscheiden am besten die <a
                class="link link-primary"
                href="#ideen">Ideen aus dem Dorf</a
              >.
            </p>
            <p class="text-base-content/80">
              Die App gehört zum <a class="link link-primary" href="/digitales-dorf"
                >digitalen Dorf</a
              > und nutzt dieselbe Rössing-ID wie die anderen Dorf-Dienste.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body">
            <div class="flex items-center gap-3">
              <h2 class="card-title text-2xl text-base-content">
                Ehrlich gesagt: noch Beta
              </h2>
              <span class="badge badge-accent">Im Test</span>
            </div>
            <ul class="mt-2 space-y-3 text-base-content/80">
              <li>
                <strong>Die App ist in der Testphase.</strong> Sie funktioniert,
                ist aber noch nicht fertig – Fehler und Ecken sind möglich.
              </li>
              <li>
                <strong>Android zuerst.</strong> Die App läuft auf
                Android-Geräten.
              </li>
              <li>
                <strong>iOS ist später geplant.</strong> Eine Version für
                iPhones gibt es noch nicht; wann sie kommt, steht noch nicht
                fest.
              </li>
              <li>
                <strong>Rückmeldungen helfen.</strong> Was hakt, was fehlt, was
                ist unverständlich? Immer her damit.
              </li>
            </ul>
            <div class="mt-4 space-y-3 text-base-content/80">
              <p>
                Verteilt wird die App über den <strong
                  >internen Test im Google Play Store</strong
                >. Du installierst sie also ganz normal über den Play Store,
                nur dass sie dort nicht öffentlich zu finden ist – man braucht
                eine Einladung. Aktualisierungen kommen danach automatisch.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Haltung: nicht kommerziell, kostenlos, werbefrei */}
  <section class="container max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="max-w-2xl mb-10">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">
        Worauf du dich verlassen kannst
      </p>
      <h2
        class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
      >
        Ein Dorfprojekt, kein Geschäft
      </h2>
      <p class="mt-3 text-base-content/70">
        Damit das gleich klar ist, bevor jemand die App installiert: Hier wird
        kein Geld verdient und niemand ausgewertet.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        haltung.map((punkt) => (
          <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body">
              <h3 class="card-title text-lg text-base-content">
                {punkt.titel}
              </h3>
              <p class="text-base-content/70">{punkt.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-base-content/70">
      Was die App im Einzelnen speichert und was nicht, steht in der <a
        class="link link-primary"
        href="/app/datenschutz">Datenschutzerklärung der App</a
      >.
    </p>
  </section>

  {/* Zum Aushängen – druckfertige PDFs */}
  <section id="aushang" class="container max-w-5xl mx-auto px-4 pb-16 sm:pb-20">
    <div class="rounded-box border border-base-300 bg-base-200 p-6 sm:p-8">
      <h2 class="text-xl font-semibold text-base-content">Zum Aushängen</h2>
      <p class="mt-2 max-w-3xl text-base-content/70">
        Wer den Aufruf im Dorf verbreiten möchte: Hier gibt es ihn druckfertig –
        für den Dorfladen, den Schaukasten oder zum Auslegen beim Verein.
        Einfach ausdrucken und aufhängen.
      </p>

      <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          aushangFormate.map((aushang) => (
            <li>
              <a
                href={aushang.url}
                class="btn btn-outline btn-primary h-auto w-full flex-col items-start gap-1 px-4 py-3 text-left font-normal normal-case"
              >
                <span class="font-semibold">
                  Aushang {aushang.format}
                  {aushang.groesse && (
                    <span class="font-normal opacity-70">
                      {' '}
                      (PDF, {aushang.groesse})
                    </span>
                  )}
                </span>
                <span class="text-xs opacity-70">{aushang.beschreibung}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Datenschutz kurz */}
  <section class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]">
    <div class="container max-w-4xl mx-auto px-4 py-16 sm:py-20">
      <h2
        class="text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
      >
        Datenschutz – kurz gesagt
      </h2>
      <ul class="mt-6 space-y-4 text-base-content/80">
        <li>
          <strong>Anmeldung über die Rössing-ID.</strong> Die läuft über unsere
          eigene Anmeldestelle unter <a
            class="link"
            href="https://id.xn--rssing-wxa.de">id.rössing.de</a
          > (Software: Zitadel), betrieben im Dorf und nicht bei einem großen Anbieter.
          Das Konto legst du dir dort selbst an – Vorname, Nachname, E-Mail und
          Passwort, mehr braucht es nicht. Wer lieber den Knopf <strong
            >„Mit Google anmelden“</strong
          > nutzt, kann das tun: Google erfährt dann, dass du dich bei der Rössing-ID
          anmeldest, und gibt Name, E-Mail-Adresse und Profilbild an sie weiter.
          Freiwillig ist das in jedem Fall – mit Konto und Passwort geht alles genauso.
        </li>
        <li>
          <strong>Der Standort bleibt auf dem Gerät.</strong> Gibst du ihn
          frei, nutzt die App ihn nur, um die Karte bei dir starten zu lassen
          und Entfernungen anzuzeigen – an den Server wird er nicht
          übertragen.
        </li>
        <li>
          <strong>Karte von OpenFreeMap.</strong> Das Kartenmaterial kommt von
          OpenFreeMap auf Basis von OpenStreetMap-Daten – ohne Konto und ohne
          Werbe-Tracking.
        </li>
        <li>
          <strong>Gespeichert wird wenig.</strong> Im Wesentlichen: welcher Ort
          wann von wem erledigt wurde. Das muss sichtbar sein, sonst würde die
          Ampel nicht funktionieren.
        </li>
        <li>
          <strong>Die Rangliste ist für alle in der App sichtbar.</strong> Dort
          steht dein Name – oder dein Nickname, wenn du einen einträgst –
          zusammen mit der Zahl deiner Erledigungen. Wer nicht mit Klarnamen
          auftauchen möchte, trägt einfach einen anderen Nickname ein.
        </li>
        <li>
          <strong>Wer sich einträgt, ist für die anderen Eingetragenen
          sichtbar.</strong> Sagst du eine Aufgabe zu, sehen die übrigen
          Helferinnen und Helfer an diesem Ort deinen Namen und bis wann du
          Zeit hast – sonst gießen zwei denselben Kasten. Eintragen ist
          freiwillig und jederzeit wieder rückgängig zu machen.
        </li>
        <li>
          <strong>Benachrichtigungen laufen über Google.</strong> Für die
          Zustellung aufs Handy führt auf Android kein Weg an Firebase Cloud
          Messaging vorbei. Google erfährt dabei eine Kennung deiner
          App-Installation sowie Titel und Text der Meldung – also Ortsname und
          Aufgabe. <strong>Namen anderer Personen stehen nie darin.</strong>
          <strong>Seit Version 0.1.8 entsteht diese Kennung erst, wenn du
          Mitteilungen erlaubt hast</strong> – vorher bleibt auch der
          Google-Baustein in der App stumm. In älteren Versionen entstand sie
          schon beim Start der App. Nimmst du die Erlaubnis in den
          Android-Einstellungen wieder zurück, wird die Kennung beim nächsten
          Öffnen der App gelöscht.
        </li>
        <li>
          <strong>Kontaktdaten nur, wenn du willst.</strong> Im Profil kannst du
          freiwillig Telefonnummer, E-Mail-Adresse oder eine kurze Notiz
          hinterlegen. Für jedes Feld stellst du selbst ein, ob es alle
          angemeldeten Dorfbewohner sehen dürfen oder nur die Verwaltenden –
          Kontaktdaten sind zunächst nicht sichtbar.
        </li>
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/app/datenschutz" class="btn btn-primary">
          Datenschutz der App
        </a>
        <a href="/app/daten-loeschen" class="btn btn-outline btn-primary">
          Konto und Daten löschen
        </a>
        <a href="/datenschutz" class="btn btn-outline">
          Datenschutz dieser Website
        </a>
      </div>
    </div>
  </section>
</Layout>
