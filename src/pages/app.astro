---
import { Image } from 'astro:assets'
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import { kontaktMail, kontaktTelefon, mailtoMitBetreff } from '@/data/kontakt'
import { aushangFormate } from '@/tools/print/aushang'
import appDetail from '../assets/app/app-detail.png'
import appKarte from '../assets/app/app-karte.png'
import appListe from '../assets/app/app-liste.png'
import appProfil from '../assets/app/app-profil.png'
import appRangliste from '../assets/app/app-rangliste.png'
import appStartseite from '../assets/app/app-startseite.png'
import AppDownload from '../components/AppDownload.astro'
import IdeenFormular from '../components/IdeenFormular.astro'
import Jumbotron from '../components/Jumbotron.astro'

const metadata = {
  title: 'Die Rössing-App',
  description:
    'Was soll die Dorf-App für Rössing können? Wir sammeln Ideen aus dem Dorf – ein Satz reicht. Die App gibt es schon: Den Anfang macht „Mithelfen“ – auf der Dorfkarte sehen, was gerade im Dorf ansteht, etwa welche Blumenkästen Wasser brauchen. Wer beim Test mitmachen möchte, meldet sich ebenfalls.',
}

// Anregungen, was eine Dorf-App leisten könnte. Ausdrücklich Beispiele –
// weder Versprechen noch Roadmap. Sie zeigen, wie weit der Rahmen ist.
const ideenBeispiele = [
  {
    titel: 'Erinnerung an Termine',
    text: 'Die Termine stehen schon in der App – es fehlt der Hinweis am Tag davor.',
  },
  {
    titel: 'Mitfahrgelegenheiten',
    text: 'Wer fährt nach Hildesheim oder Nordstemmen und hat einen Platz frei?',
  },
  {
    titel: 'Werkzeug verleihen',
    text: 'Anhänger, Vertikutierer, Bierzeltgarnitur: Wer hat was und gibt es gern weiter?',
  },
  {
    titel: 'Schwarzes Brett',
    text: 'Suche und Biete – vom Kinderfahrrad über Brennholz bis zur freien Wohnung.',
  },
  {
    titel: 'Nachbarschaftshilfe',
    text: 'Einkauf mitbringen, im Garten helfen: fragen und sehen, wo man helfen kann.',
  },
  {
    titel: 'Nachrichten der Vereine',
    text: 'Trainingsausfall, Probentermin, Absage – ohne WhatsApp-Gruppe für alles.',
  },
  {
    titel: 'Kaputtes melden',
    text: 'Laterne aus, Bank wackelt: fotografieren, melden, alle sehen es.',
  },
  {
    titel: 'Dorfchronik und Bilder',
    text: 'Alte Fotos und Geschichten aus Rössing – und alle können ergänzen.',
  },
]

// Die Haltung hinter dem Projekt – bewusst gut sichtbar auf der Seite.
const haltung = [
  {
    titel: 'Aus dem Dorf, ehrenamtlich',
    text: 'Entsteht in der Freizeit als Teil des digitalen Dorfs. Kein Unternehmen, keine Agentur, kein Auftrag.',
  },
  {
    titel: 'Kostenlos und werbefrei',
    text: 'Kein Kaufpreis, kein Abo, keine Werbung, kein Werbe-Tracking – auch später nicht.',
  },
  {
    titel: 'Keine Gewinnabsicht',
    text: 'Niemand verdient daran, weder an der App noch an den Daten. Sie soll dem Dorf nützen.',
  },
  {
    titel: 'Daten bleiben im Dorf',
    text: 'Eigener Server, eigene Rössing-ID, Standort bleibt auf dem Gerät. Über Google laufen nur die Benachrichtigungen.',
  },
  {
    titel: 'Quellcode soll offen werden',
    text: 'Noch liegt er in einem privaten Repository – offengelegt werden soll er nach dem ersten Test.',
  },
]

// Ampel-Logik der App – dieselben drei Zustände wie in der App selbst.
const ampel = [
  {
    farbe: 'bg-success',
    label: 'Grün',
    text: 'Alles erledigt – du kannst beruhigt weitergehen.',
  },
  {
    farbe: 'bg-warning',
    label: 'Gelb',
    text: 'Der übliche Abstand ist überschritten – gern gießen oder jäten.',
  },
  {
    farbe: 'bg-error',
    label: 'Rot',
    text: 'Wartet schon länger. Jetzt wird es Zeit.',
  },
]

// Die Bereiche, die es in der App heute gibt. „Mithelfen“ steht bewusst
// zuerst – es ist die erste Funktion und der Grund, warum es die App gibt.
const bereiche = [
  {
    titel: 'Mithelfen',
    text: 'Blumenkästen und Beete auf der Karte und als Liste, jeweils mit Ampel. Erledigt wird mit einem Tipp gemeldet.',
  },
  {
    titel: 'Als Helfer:in eintragen',
    text: 'An einem Ort eintragen – für alles oder nur fürs Gießen bzw. Jäten. Die App fragt dich, wenn dort etwas fällig wird.',
  },
  {
    titel: 'Benachrichtigungen',
    text: 'Anfragen zusagen oder zurückgeben. Auf Wunsch zusätzlich aufs Handy – nachts ist Ruhe.',
  },
  {
    titel: 'Veranstaltungen',
    text: 'Dieselben Termine wie hier auf rössing.de – niemand pflegt sie zweimal.',
  },
  {
    titel: 'Rangliste',
    text: 'Wer wie oft gegossen oder gejätet hat, wahlweise pro Woche bis Gesamt – dazu die Dorfsumme und ein paar Abzeichen.',
  },
  {
    titel: 'Profil und Dorfbewohner',
    text: 'Für jedes Feld stellst du selbst ein, wer es sehen darf. Telefon und E-Mail sind zunächst nicht sichtbar.',
  },
  {
    titel: 'Idee vorschlagen',
    text: 'Auch direkt in der App – anonym möglich, ein Satz reicht.',
  },
  {
    titel: 'Weitere Bereiche kommen',
    text: 'Was als Nächstes dazukommt, entscheiden die Ideen aus dem Dorf.',
  },
]

// Screenshots aus der App (Android, Testphase).
const screenshots = [
  {
    src: appStartseite,
    alt: 'Startseite der Rössing-App mit der Begrüßung „Moin, Erna!“, der großen Kachel „Mithelfen – Was gerade im Dorf ansteht“ mit dem Hinweis „2 Orte warten auf dich“ sowie den Kacheln „Mein Profil“ und „Dorfbewohner“.',
    caption: 'Die Startseite mit den Bereichen der App',
  },
  {
    src: appKarte,
    alt: 'Dorfkarte von Rössing in der App mit farbigen Punkten – grün, gelb und rot – rund um das Wasserschloss, dazu ein Knopf für den eigenen Standort.',
    caption: 'Die Dorfkarte mit Ampel-Markern',
  },
  {
    src: appListe,
    alt: 'Listenansicht in der App, sortierbar nach Dringlichkeit oder Entfernung: „Unter den Eichen — Kasten 1“ mit rotem „Dringend!“, darunter gelbe und grüne Einträge.',
    caption: 'Alle Orte als Liste – nach Dringlichkeit oder Entfernung',
  },
  {
    src: appDetail,
    alt: 'Detailansicht eines Blumenkastens in der App mit der Angabe „10 Liter, alle 7 Tage“, dem Vermerk „Zuletzt: 9.8.2026 17:20 von Karl“ und dem Knopf „Ich habe gegossen“.',
    caption: 'Melden, dass du gegossen hast',
  },
  {
    src: appRangliste,
    alt: 'Rangliste in der App mit den Zeiträumen Woche, Monat, Saison, Jahr und Gesamt, der Dorfsumme „31 Erledigungen · 310 Liter · 4 Beteiligte“ und den Plätzen eins bis vier.',
    caption: 'Die Rangliste – auch für das ganze Dorf',
  },
  {
    src: appProfil,
    alt: 'Profilseite in der App mit den Feldern Anzeigename und Nickname, jeweils mit einem Schalter „Für alle Dorfbewohner sichtbar“, darunter das freiwillige Feld für die Telefonnummer.',
    caption: 'Im Profil entscheidest du Feld für Feld, wer was sieht',
  },
]
---

<Layout {...metadata}>
  <Jumbotron>
    <div class="m-auto max-w-3xl text-center">
      <span class="badge badge-accent badge-lg mb-4">Ideen gesucht</span>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Was soll die Rössing-App können?
      </h1>
      <p class="mt-6 text-lg leading-8 text-white/90">
        Es gibt sie schon: <strong>„Mithelfen“</strong> zeigt, welche Blumenkästen
        und Beete gerade Wasser brauchen. Das ist der Anfang, nicht der Zweck.
        Denk ruhig groß – technisch ist viel möglich, und Ideen, die dem Dorf
        helfen, werden auch gebaut. <strong>Ein Satz reicht.</strong>
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="#ideen" class="btn btn-primary btn-lg">Idee vorschlagen</a>
        <a href="#mitmachen" class="btn btn-lg glass text-white">
          Beim Test mitmachen
        </a>
      </div>
    </div>
  </Jumbotron>

  {/* Die Hauptsache: Ideen aus dem Dorf sammeln */}
  <section
    id="ideen"
    class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]"
  >
    <div class="container max-w-7xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Deine Idee
        </p>
        <h2
          class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
        >
          Sag uns, was die App fürs Dorf können soll
        </h2>
        <p class="mt-3 text-base-content/70">
          „Mithelfen“ ist <strong>nur die erste Funktion</strong> – was als
          Nächstes hineinkommt, soll sich daran entscheiden, was hier
          tatsächlich gebraucht wird. Also: <strong>Was würde dir den Alltag
          in Rössing leichter machen?</strong> Was wir nicht bauen können,
          sagen wir ehrlich; einige Wünsche aus dem ersten Test sind schon bei
          den <a class="link link-primary" href="/app/fragen">Fragen aus dem
          Dorf</a> beantwortet.
        </p>
      </div>

      <div class="mt-10">
        <h3 class="text-xl font-semibold text-base-content">
          Denkbar wäre zum Beispiel …
        </h3>
        <p class="mt-2 max-w-3xl text-base-content/70">
          Anregungen, damit der Rahmen klar wird – <strong>kein Versprechen
          und kein fertiger Plan.</strong> Vor allem interessiert uns, was
          <em>euch</em> einfällt.
        </p>

        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            ideenBeispiele.map((idee) => (
              <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                  <h4 class="card-title text-lg text-base-content">
                    {idee.titel}
                  </h4>
                  <p class="text-base-content/70">{idee.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <IdeenFormular />

      <p class="mt-6 text-sm text-base-content/60">
        Ein Satz genügt – wenn du magst, schreib dazu, für wen das gut wäre und
        was heute umständlich ist. Lieber per E-Mail? <a
          class="link"
          href={mailtoMitBetreff('Rössing-App: Meine Idee')}>{kontaktMail}</a
        >. Wer lieber redet als schreibt, ruft unter <a
          class="link"
          href={`tel:${kontaktTelefon}`}>{kontaktTelefon}</a
        > an.
      </p>
    </div>
  </section>

  <AppDownload />

  {/* So funktioniert's */}
  <section id="so-gehts" class="container max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">
        Was die App heute kann
      </p>
      <h2
        class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
      >
        Mithelfen: Was gerade im Dorf ansteht
      </h2>
      <p class="mt-3 text-base-content/70">
        Du hast Zeit und willst etwas fürs Dorf tun – aber was steht an? Genau
        dafür ist „Mithelfen“ da: aufmachen, schauen, gießen, melden.
      </p>
    </div>

    <ul class="steps steps-vertical lg:steps-horizontal w-full mt-10">
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Anmelden</p>
          <p class="text-sm text-base-content/70">
            Einmalig mit der <a class="link" href="https://id.xn--rssing-wxa.de"
              >Rössing-ID</a
            >; das Konto legst du dir selbst an. Google-Anmeldung geht auch, ist
            aber nicht nötig.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Karte anschauen</p>
          <p class="text-sm text-base-content/70">
            Eine Ampel zeigt, wo etwas ansteht – wahlweise als Liste, nach
            Dringlichkeit oder Entfernung sortiert.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Gießen oder jäten</p>
          <p class="text-sm text-base-content/70">
            Bei jedem Ort steht, was zu tun ist – „10 Liter, alle 7 Tage“ oder
            einmalig zu einem festen Termin.
          </p>
        </div>
      </li>
      <li class="step step-primary">
        <div class="mt-2 lg:mt-4 lg:px-2">
          <p class="font-semibold text-base-content">Melden</p>
          <p class="text-sm text-base-content/70">
            Ein Tipp auf „Ich habe gegossen“ – die Ampel springt auf Grün, alle
            sehen es sofort.
          </p>
        </div>
      </li>
    </ul>

    <ul class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4">
      {
        ampel.map((zustand) => (
          <li class="flex items-start gap-3 text-base-content/70">
            <span
              class={`mt-1.5 inline-block size-4 shrink-0 rounded-full ${zustand.farbe}`}
            />
            <span>
              <strong class="text-base-content">{zustand.label}:</strong>{' '}
              {zustand.text}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-3xl text-sm text-base-content/60">
      Wie lange etwas ohne Wasser auskommt, ist hinterlegt – bei Hitze wird der
      Abstand automatisch kürzer. Nach einer Erledigung ist ein Ort eine Weile
      gesperrt, damit nichts doppelt gegossen wird.
    </p>

    <div class="mt-14">
      <h3 class="text-xl font-semibold text-base-content">
        Neu: Du kannst dich eintragen – und wirst dann gefragt
      </h3>
      <div class="mt-3 max-w-3xl space-y-3 text-base-content/70">
        <p>
          Bei jedem Ort gibt es „Hier als Helfer:in eintragen“ – für alles oder
          nur fürs Gießen bzw. Jäten, jederzeit wieder rückgängig zu machen.
          Wird dort etwas fällig, fragt die App nicht alle auf einmal, sondern
          <strong>der Reihe nach</strong>: erst, wer am längsten nicht gefragt
          wurde, eine Stunde später die nächste Person.
        </p>
        <p>
          Sagst du zu, <strong>gehört die Aufgabe für 24 Stunden dir</strong> –
          die anderen sehen, dass sie vergeben ist. Mit „Zurückgeben“ gibst du
          sie wieder frei, sonst wird sie nach 24 Stunden von selbst frei.
          Sagt am Ende niemand zu, geht eine letzte Frage an alle; meldet sich
          auch dann niemand, bleibt der Ort rot stehen.
        </p>
        <p>
          Die Anfragen stehen unter „Benachrichtigungen“, auf Wunsch zusätzlich
          aufs Handy. Wer keine Erlaubnis gibt, verpasst nichts – zwischen 21
          und 7 Uhr wird ohnehin nichts zugestellt.
        </p>
      </div>
    </div>

    <div class="mt-14">
      <h3 class="text-xl font-semibold text-base-content">
        Die Bereiche der App
      </h3>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          bereiche.map((bereich) => (
            <div class="card bg-base-100 border border-base-300 shadow-sm">
              <div class="card-body">
                <h4 class="card-title text-lg text-base-content">
                  {bereich.titel}
                </h4>
                <p class="text-base-content/70">{bereich.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Screenshots */}
  <section class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]">
    <div class="container max-w-7xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-2xl mb-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Blick in die App
        </p>
        <h2
          class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
        >
          So sieht das aus
        </h2>
        <p class="mt-3 text-base-content/70">
          Aufnahmen aus der Testversion für Android. Orte, Namen und Zahlen sind
          Beispiele aus der Testumgebung. Die Bilder sind ein paar Wochen alt –
          Helfer-Eintrag, Benachrichtigungen und Veranstaltungen fehlen darauf
          noch.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {
          screenshots.map((shot) => (
            <figure class="flex flex-col gap-3">
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 320px, (min-width: 640px) 40vw, 45vw"
                class="w-full rounded-box border border-base-300 shadow-sm"
                loading="lazy"
              />
              <figcaption class="text-sm text-base-content/70">
                {shot.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* Eine App fürs ganze Dorf + Status */}
  <section class="container max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body">
          <h2 class="card-title text-2xl text-base-content">
            Eine App fürs ganze Dorf
          </h2>
          <p class="text-base-content/80">
            Keine reine „Gieß-App“: Nach „Mithelfen“ sind als Zweites die
            <strong>Veranstaltungen</strong> dazugekommen. Was danach kommt,
            versprechen wir bewusst noch nicht – das entscheiden am besten die
            <a class="link link-primary" href="#ideen">Ideen aus dem Dorf</a>.
          </p>
          <p class="text-base-content/80">
            Die App gehört zum <a class="link link-primary" href="/digitales-dorf"
              >digitalen Dorf</a
            > und nutzt dieselbe Rössing-ID wie die anderen Dorf-Dienste. Was sie
            bewusst <em>nicht</em> machen wird, steht bei den <a
              class="link link-primary"
              href="/app/fragen">Fragen aus dem Dorf</a
            >.
          </p>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body">
          <div class="flex items-center gap-3">
            <h2 class="card-title text-2xl text-base-content">
              Ehrlich gesagt: noch Beta
            </h2>
            <span class="badge badge-accent">Im Test</span>
          </div>
          <ul class="mt-2 space-y-3 text-base-content/80">
            <li>
              <strong>Die App ist in der Testphase.</strong> Sie funktioniert, ist
              aber noch nicht fertig – Fehler und Ecken sind möglich.
            </li>
            <li>
              <strong>Android zuerst.</strong> Eine Version für iPhones ist geplant,
              ein Termin steht nicht fest.
            </li>
            <li>
              <strong>Rückmeldungen helfen.</strong> Was hakt, was fehlt, was ist
              unverständlich? Immer her damit.
            </li>
          </ul>
          <p class="mt-4 text-base-content/80">
            Verteilt wird über den <strong>internen Test im Google Play
            Store</strong>: ganz normal installieren, nur eben mit Einladung.
            Aktualisierungen kommen automatisch.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Haltung: nicht kommerziell, kostenlos, werbefrei */}
  <section class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]">
    <div class="container max-w-5xl mx-auto px-4 py-16 sm:py-20">
      <div class="max-w-2xl mb-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Worauf du dich verlassen kannst
        </p>
        <h2
          class="mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl"
        >
          Ein Dorfprojekt, kein Geschäft
        </h2>
        <p class="mt-3 text-base-content/70">
          Damit das gleich klar ist: Hier wird kein Geld verdient und niemand
          ausgewertet.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          haltung.map((punkt) => (
            <div class="card bg-base-100 border border-base-300 shadow-sm">
              <div class="card-body">
                <h3 class="card-title text-lg text-base-content">
                  {punkt.titel}
                </h3>
                <p class="text-base-content/70">{punkt.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Datenschutz kurz */}
  <section class="container max-w-4xl mx-auto px-4 py-16 sm:py-20">
    <h2 class="text-3xl font-bold tracking-tight text-base-content sm:text-4xl">
      Datenschutz – kurz gesagt
    </h2>
    <ul class="mt-6 space-y-4 text-base-content/80">
      <li>
        <strong>Anmeldung über die Rössing-ID.</strong> Eigene Anmeldestelle unter
        <a class="link" href="https://id.xn--rssing-wxa.de">id.rössing.de</a> (Zitadel),
        betrieben im Dorf. Das Konto legst du dir selbst an; die Google-Anmeldung
        ist freiwillig.
      </li>
      <li>
        <strong>Standort und Karte.</strong> Der Standort bleibt auf dem Gerät und
        wird nicht übertragen. Das Kartenmaterial kommt von OpenFreeMap – ohne Konto,
        ohne Werbe-Tracking.
      </li>
      <li>
        <strong>Sichtbar ist wenig, aber nicht nichts.</strong> Wer wann welchen
        Ort erledigt hat, sehen alle – sonst funktioniert die Ampel nicht. In der
        Rangliste steht dein Name oder ein selbst gewählter Nickname, und wer eine
        Aufgabe zusagt, ist für die übrigen Helfenden am Ort sichtbar.
      </li>
      <li>
        <strong>Benachrichtigungen laufen über Google.</strong> Auf Android führt
        an Firebase kein Weg vorbei: Google erfährt eine Kennung deiner Installation
        sowie Ortsname und Aufgabe – <strong>Namen anderer Personen nie</strong>.
        Die Kennung entsteht erst, wenn du Mitteilungen erlaubst, und wird gelöscht,
        sobald du die Erlaubnis zurücknimmst.
      </li>
      <li>
        <strong>Kontaktdaten nur, wenn du willst.</strong> Telefon, E-Mail und Notiz
        sind freiwillig; für jedes Feld stellst du die Sichtbarkeit selbst ein.
      </li>
    </ul>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/app/datenschutz" class="btn btn-primary">Datenschutz der App</a>
      <a href="/app/daten-loeschen" class="btn btn-outline btn-primary">
        Konto und Daten löschen
      </a>
      <a href="/datenschutz" class="btn btn-outline">
        Datenschutz dieser Website
      </a>
    </div>
  </section>

  {/* Zum Aushängen – druckfertige PDFs */}
  <section
    id="aushang"
    class="bg-base-200 w-screen ml-[calc(50%-50vw)] mr-[calc(50%-50vw)]"
  >
    <div class="container max-w-5xl mx-auto px-4 py-12 sm:py-16">
      <h2 class="text-xl font-semibold text-base-content">Zum Aushängen</h2>
      <p class="mt-2 max-w-3xl text-base-content/70">
        Den Aufruf gibt es druckfertig – für den Dorfladen, den Schaukasten oder
        zum Auslegen beim Verein.
      </p>

      <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          aushangFormate.map((aushang) => (
            <li>
              <a
                href={aushang.url}
                class="btn btn-outline btn-primary h-auto w-full flex-col items-start gap-1 px-4 py-3 text-left font-normal normal-case"
              >
                <span class="font-semibold">
                  Aushang {aushang.format}
                  {aushang.groesse && (
                    <span class="font-normal opacity-70">
                      {' '}
                      (PDF, {aushang.groesse})
                    </span>
                  )}
                </span>
                <span class="text-xs opacity-70">{aushang.beschreibung}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
