---
import Layout from '@levino/shipyard-base/layouts/Page.astro'
import Jumbotron from '../components/Jumbotron.astro'
import Project from '../components/Project.astro'
import ffwImage from '../images/ffw.jpeg'

const metadata = {
  title: 'Rössing',
  description: 'Alle Infos über Rössing',
}
---

<Layout {...metadata}>
  <Jumbotron>
    <div class="m-auto max-w-2xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Willkommen in Rössing
      </h1>
      <p class="mt-6 text-lg leading-8 text-white/80">
        Rössing ist ein Dorf in Niedersachsen und gehört zur Gemeinde
        Nordstemmen im Landkreis Hildesheim. Wir haben im Moment etwa 1600
        Einwohner:innen und zahlreiche Vereine und Organe. Hier findet sich eine
        Übersicht.
      </p>
    </div>
  </Jumbotron>

  <section class="bg-base-200">
    <div class="container max-w-5xl mx-auto px-4 py-20 text-center">
      <span class="badge badge-accent badge-lg mb-4">Im Aufbau</span>
      <h2 class="text-3xl font-bold tracking-tight text-base-content sm:text-4xl">
        Rössing baut sich ein digitales Dorf
      </h2>
      <p class="mt-6 text-lg leading-8 text-base-content/70 max-w-3xl mx-auto">
        Gemeinsam bauen wir eine moderne, selbst gehostete digitale
        Infrastruktur für unser Dorf – eine zentrale „Dorf-ID“ als ein Login für
        alle Dienste, Apps und Vereine. Selbst gehostet, als Code und mit KI
        gebaut und gepflegt: nachhaltig, unabhängig und auf dem Weg zu einem der
        digitalsten Dörfer Deutschlands. Vieles läuft schon, anderes ist in
        Arbeit.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/digitales-dorf" class="btn btn-primary">
          Das digitale Dorf entdecken
        </a>
        <a
          href="https://id.xn--rssing-wxa.de"
          class="btn btn-outline"
          rel="noopener noreferrer"
          target="_blank"
        >
          Zur Dorf-ID
        </a>
      </div>
    </div>
  </section>

  <div
    class="container max-w-7xl px-4 mx-auto gap-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 py-32"
  >
    <Project
      title="Die Dorfpflege"
      subtitle="Rössings Natur und Grünflächen in Schuss halten"
      linkUrl="https://www.dorfpflege-roessing.de"
    >
      <p class="text-base-content/80">
        Die Dorfpflege ist ein Verein, der sich um die Streuobstwiese im Dorf
        kümmert, gemeinsam Müll sammelt und sich um die Pflegemaßnahmen der
        Grünflächen und -bereiche kümmert. Außerdem organisiert die Dorfpflege
        das Osterfeuer und den Weihnachtsmarkt von Rössing.
      </p>
    </Project>
    <Project
      imageSource={ffwImage}
      title="Die Freiwillige Feuerwehr"
      subtitle="Retten, sichern und bergen in und um Rössing"
      linkUrl="https://www.ff-roessing.de"
    >
      <p class="text-base-content/80">
        Natürlich hat Rössing auch eine freiwillige Feuerwehr!
      </p>
    </Project>
  </div>
</Layout>
